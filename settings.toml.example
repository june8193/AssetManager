# 키움증권 REST API 서비스 URL
base_url = "https://api.kiwoom.com"

# 데이터베이스 설정
[database]
url = "sqlite:///./src/assets.db"

# 증권사 계좌 정보 목록 (여러 계정 등록 가능)
[[accounts]]
broker = "키움증권"                # 증권사 명칭
account = "5526-9093"             # 계좌 번호
app_key = "YOUR_APP_KEY"          # 발급받은 APP KEY
secret_key = "YOUR_SECRET_KEY"     # 발급받은 SECRET KEY

# 데이터베이스 자동 백업 설정
[backup]
interval_hours = 24    # 백업 주기 (단위: 시간)
path = "./backups"     # 백업 파일이 저장될 상대/절대 경로
max_files = 7           # 보관할 최대 백업 파일 개수 (초과 시 오래된 파일부터 삭제)

# 텔레그램 봇 연동 설정
[telegram]
bot_token = "YOUR_TELEGRAM_BOT_TOKEN"
allowed_user_ids = [123456789]
enabled = false
storage_dir = "G:/내 드라이브/투자/Asset_jun_bot_storage"

# 네이버 뉴스 검색 API 연동 설정
[naver]
client_id = "YOUR_NAVER_CLIENT_ID"
client_secret = "YOUR_NAVER_CLIENT_SECRET"

# 지출 모니터링 명세서 복호화 설정
[expenses]
default_password = "YOUR_DEFAULT_PASSWORD" # 명세서 자동 복호화용 기본 비밀번호 (생년월일 6자리 등)

